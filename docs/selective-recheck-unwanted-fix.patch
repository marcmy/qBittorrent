+        m_nativeHandle.recheck_files(std::move(nativeIndexes));
+        if (progress)
+            progress(0, 0);
 #endif
+    };
+
+    if (!indexesToRename.isEmpty())
+    {
+        // The selected files must be checked where their *current* priority says
+        // they live: ignored files in .unwanted, wanted files at the normal path.
+        // Queue the recheck first so even very fast rename completion cannot race it.
+        m_moveFinishedTriggers.enqueue(std::move(startRecheck));
+        for (const int index : asConst(indexesToRename))
