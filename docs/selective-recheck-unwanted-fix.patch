+        if (actualFilePath(index) != expectedActualPath)
+            indexesToRename.append(index);
+    }
+
+    auto startRecheck = [this, validIndexes, progress = std::move(progress)]() mutable
+    {
+        std::vector<lt::file_index_t> nativeIndexes;
